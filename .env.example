# Copy to .env.local (auto-loaded via direnv / .envrc) and fill in.
#
# PREFERRED for shared secrets: don't paste values here — they come from the
# `neuraffica` 1Password vault via op.env + `op run`. Run tasks with
# `task secrets:run -- <cmd>` (or just `task <runtime-task>`). See AGENT.md ->
# "Secrets (1Password)". Use .env.local only for personal, non-vault overrides.

# =============================================================================
# Hugging Face
# =============================================================================
# HF_TOKEN=
# HF_HOME=~/.cache/huggingface

# =============================================================================
# Experiment tracking
# =============================================================================
# WANDB_API_KEY=
# WANDB_PROJECT=tokenizer
# WANDB_MODE=offline   # disable cloud sync for local-only runs

# =============================================================================
# Data store
# =============================================================================
# Override where corpora + large artifacts are read/written (defaults to the
# mounted Nextcloud path in op.env).
# TOKENIZER_DATA_DIR=/home/dev/nextcloud/data/tokenizer

# =============================================================================
# Hyperstack — remote GPU (only for the optional gpt2 PoC retrain)
# =============================================================================
# HYPERSTACK_SSH_HOST=10.0.0.5
# HYPERSTACK_SSH_USER=ubuntu
# HYPERSTACK_SSH_KEY_FILE=~/.ssh/hyperstack
# HYPERSTACK_REMOTE_DIR=~/tokenizer
