# 1Password secret references — SAFE TO COMMIT.
#
# This file contains NO secrets, only pointers (`op://…` references) into the
# `neuraffica` 1Password vault. Real values are resolved at runtime by
#   `op run --env-file=op.env -- <command>`
# (wrapped for you by scripts/op-run.sh; Taskfile runtime tasks use it).
#
# Format: KEY=op://neuraffica/<item-title>/credential
#   - vault is `neuraffica`; every secret item is an "API Credential" whose
#     concealed field is `credential`.
#   - lines that are plain `KEY=value` (no `op://`) pass through literally —
#     ALL non-secret config lives here as literals, never hard-coded in Python.
#   - verify resolution with `task secrets:check`.
#
# See AGENT.md → "Secrets (1Password)" for the full workflow.

# =============================================================================
# Hugging Face — corpus + model/tokenizer downloads
# =============================================================================
# Pull training/benchmark corpora (OSCAR, CC-100, mC4, Wikipedia, ...) and the
# baseline model tokenizers (gpt2, Llama, Mistral, Qwen, Gemma, ...). Some are
# gated and need an authenticated token.
HF_TOKEN=op://neuraffica/hf-token/credential
HF_HOME=~/.cache/huggingface

# =============================================================================
# Experiment tracking — Weights & Biases (optional)
# =============================================================================
# Tokenizer-training + gpt2 PoC runs log fertility/quality curves here. Runs
# still work offline (WANDB_MODE=offline) without the key.
WANDB_API_KEY=op://neuraffica/wandb-api-key/credential
WANDB_MODE=online
WANDB_PROJECT=tokenizer

# =============================================================================
# Hyperstack — remote GPU (only for the gpt2 retraining proof-of-concept)
# =============================================================================
# The core deliverables (tokenizer training, fertility benchmarking, and the
# training-free OMP embedding transplant) need NO GPU. Only the optional gpt2
# PoC retrain uses the remote GPU VM. scripts/gpu-run.sh skips gracefully until
# HYPERSTACK_SSH_HOST resolves to a real host.
HYPERSTACK_API_KEY=op://neuraffica/hyperstack-api-key/credential
HYPERSTACK_USD_PER_GPU_HOUR=op://neuraffica/hyperstack-usd-per-gpu-hour/credential
HYPERSTACK_SSH_HOST=op://neuraffica/hyperstack-ssh-host/credential
HYPERSTACK_SSH_USER=ubuntu
HYPERSTACK_SSH_PORT=22
HYPERSTACK_REMOTE_DIR=~/tokenizer
HYPERSTACK_SSH_KEY=op://neuraffica/hyperstack-ssh-key/credential
HYPERSTACK_UV_TORCH_BACKEND=cu129

# =============================================================================
# Nextcloud data store (neuranotes) — where corpora + large outputs live
# =============================================================================
# Non-secret literal: the mounted path of the shared data folder. Input data
# and large tokenizer artifacts are written here, not into the git repo.
TOKENIZER_DATA_DIR=/home/dev/nextcloud/data/tokenizer
